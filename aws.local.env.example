# Copy to aws.local.env (gitignored). Used by local deploy scripts.
# Prefer: aws configure --profile jakshwealth  (stores keys in ~/.aws/credentials)

AWS_PROFILE=jakshwealth
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Account root / owner email (console login only — not used by CLI)
AWS_ACCOUNT_EMAIL=jakshu2024@gmail.com

# Only if NOT using ~/.aws/credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Fill after: aws sts get-caller-identity --profile jakshwealth
AWS_ACCOUNT_ID=305068201745
