{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MonthlyTransparencyStepFunctionAccess",
      "Effect": "Allow",
      "Action": [
        "states:StartExecution",
        "states:DescribeExecution",
        "states:GetExecutionHistory",
        "states:ListExecutions"
      ],
      "Resource": [
        "arn:aws:states:ap-south-2:*:stateMachine:ccd_mnthly_updts",
        "arn:aws:states:ap-south-2:*:execution:ccd_mnthly_updts:*"
      ]
    },
    {
      "Sid": "ListStateMachinesForArnResolution",
      "Effect": "Allow",
      "Action": [
        "states:ListStateMachines"
      ],
      "Resource": "*"
    }
  ]
}
