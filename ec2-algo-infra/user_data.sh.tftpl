#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/kite-algo-setup-bootstrap.log | logger -t kite-algo-setup) 2>&1

dnf upgrade -y
dnf install -y python3 python3-pip python3-dateutil nginx awscli-2 unzip

if ! id kite-algo-setup >/dev/null 2>&1; then
  useradd --system --home-dir /var/lib/kite-algo-setup --create-home --shell /sbin/nologin kite-algo-setup
fi
install -d -o root -g root -m 0755 /opt/kite-algo-setup
install -d -o kite-algo-setup -g kite-algo-setup -m 0750 /var/lib/kite-algo-setup
install -d -o kite-algo-setup -g kite-algo-setup -m 0750 /opt/kite-algo-setup/current

cat > /etc/nginx/nginx.conf <<'NGINX'
worker_processes 1;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;
events { worker_connections 128; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /var/log/nginx/access.log;
  sendfile on;
  keepalive_timeout 65;
  server {
    listen 8080;
    server_name _;

    add_header Access-Control-Allow-Origin * always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE, PATCH" always;
    add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Platform-User-Id,X-Amz-Date,X-Api-Key,X-Amz-Security-Token,X-Amzn-Trace-Id,X-Request-Id" always;
    add_header Access-Control-Expose-Headers "Content-Length,Content-Range" always;

    if ($request_method = OPTIONS) {
      return 204;
    }

    location = /health {
      default_type application/json;
      return 200 '{"status":"ok","service":"kite-algo-setup","environment":"Parallel-Test"}\n';
    }
    location /logic/ {
      proxy_pass http://127.0.0.1:8090;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_read_timeout 900s;
    }
    location /scans {
      proxy_pass http://127.0.0.1:8090;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_read_timeout 900s;
    }
    location /jw-api/kite/ {
      proxy_pass http://127.0.0.1:8082/api/kite/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_read_timeout 60s;
    }
    location /jw-api/auth/ {
      proxy_pass http://127.0.0.1:8082/auth/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_read_timeout 60s;
    }
    location /jw-api/scanner-data {
      proxy_pass http://127.0.0.1:8082/api/scanner-data;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_read_timeout 60s;
    }
    location /jw-api/ohlc {
      proxy_pass http://127.0.0.1:8082/api/ohlc;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_read_timeout 60s;
    }
    location /jw-api/algo-orders/ {
      proxy_pass http://127.0.0.1:8082/api/algo-orders/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_read_timeout 60s;
    }
    location /jw-api/ws/ {
      proxy_pass http://127.0.0.1:8082/ws/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_read_timeout 60s;
    }

    location /jw-api/ {
      proxy_pass http://127.0.0.1:8082/api/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_read_timeout 900s;
    }
  }
}
NGINX

# Start nginx EARLY to pass health checks during long pip install
rm -f /etc/nginx/conf.d/*.conf
/usr/sbin/nginx -t || true
systemctl enable --now nginx

# Now do the long pip install (can run while health checks pass)
python3 -m pip install --no-cache-dir --ignore-installed --upgrade --force-reinstall 'kiteconnect>=5.0.1,<6' boto3 fastapi uvicorn sqlalchemy psycopg2-binary requests yfinance pandas pydantic || true

cat > /usr/local/bin/kite-algo-setup-install <<'INSTALL'
#!/bin/bash
set -euo pipefail
ARCHIVE=/var/lib/kite-algo-setup/jakshwealth-api.zip
ROOT=/opt/kite-algo-setup/current
if [ ! -s "$${ARCHIVE}" ]; then
  echo "API bundle is not on this instance yet."
  exit 0
fi
rm -rf "$${ROOT}"
mkdir -p "$${ROOT}"
unzip -qo "$${ARCHIVE}" -d "$${ROOT}"
python3 -m pip install --no-cache-dir --ignore-installed -r "$${ROOT}/ec2_host/requirements.txt"
chown -R kite-algo-setup:kite-algo-setup /var/lib/kite-algo-setup
systemctl enable kite-desk.service
systemctl restart kite-desk.service
/usr/local/bin/kite-algo-setup-publish || true
INSTALL
chmod 0755 /usr/local/bin/kite-algo-setup-install

cat > /usr/local/bin/kite-algo-setup-publish <<'PUBLISH'
#!/bin/bash
python3 - <<'PY'
import json
import boto3
url = "${api_base_url}".rstrip("/")
payload = json.dumps({"kite": url + "/jw-api/kite", "api": url + "/jw-api/"}).encode("utf-8")
boto3.client("s3").put_object(
    Bucket="${ui_bucket}",
    Key="kite-api-base.json",
    Body=payload,
    ContentType="application/json",
    CacheControl="max-age=60",
)
print("published kite-api-base.json", flush=True)
PY
PUBLISH
chmod 0755 /usr/local/bin/kite-algo-setup-publish

cat > /usr/local/bin/kite-algo-setup-sync <<'SYNC'
#!/bin/bash
set -euo pipefail
DEST=/var/lib/kite-algo-setup/jakshwealth-api.zip
TMP=/var/lib/kite-algo-setup/jakshwealth-api.zip.tmp
python3 - "$${TMP}" "${artifact_bucket}" <<'PY'
import sys
import boto3
from pathlib import Path

tmp_file = sys.argv[1]
bucket = sys.argv[2]

try:
    s3 = boto3.client('s3')
    s3.download_file(bucket, 'kite-algo-setup/jakshwealth-api.zip', tmp_file)
except Exception as e:
    print(f"Failed to download: {e}", file=sys.stderr)
    Path(tmp_file).unlink(missing_ok=True)
    sys.exit(0)
PY
if [ -f "$${DEST}" ] && cmp -s "$${TMP}" "$${DEST}"; then
  rm -f "$${TMP}"
  /usr/local/bin/kite-algo-setup-publish || true
  exit 0
fi
mv "$${TMP}" "$${DEST}"
/usr/local/bin/kite-algo-setup-install
SYNC
chmod 0755 /usr/local/bin/kite-algo-setup-sync

cat > /etc/systemd/system/kite-scan.service <<'UNIT'
[Unit]
Description=Kite algo local scan helper
After=network-online.target

[Service]
Type=simple
User=kite-algo-setup
Group=kite-algo-setup
WorkingDirectory=/opt/kite-algo-setup
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/kite-algo-setup
Environment=HOME=/var/lib/kite-algo-setup
ExecStart=/usr/bin/python3 /opt/kite-algo-setup/server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT

python3 - <<'PY'
from pathlib import Path
try:
  text = Path("/opt/kite-algo-setup/server.py").read_text(encoding="utf-8")
  text = text.replace('PORT = 8080', 'PORT = 8090')
  Path("/opt/kite-algo-setup/server.py").write_text(text, encoding="utf-8")
except FileNotFoundError:
  pass
PY

# Fetch DATABASE_URL from Secrets Manager and write environment file
mkdir -p /etc/kite-algo-setup
python3 - "${db_secret_id}" "${aws_region}" <<'PY'
import sys
import json
import boto3
from pathlib import Path

secret_id = sys.argv[1]
region = sys.argv[2]
try:
    secret = boto3.client('secretsmanager', region_name=region).get_secret_value(SecretId=secret_id)
    data = json.loads(secret['SecretString'])
    print(f"Secret keys: {list(data.keys())}", file=__import__('sys').stderr)

    # Extract database credentials
    database_url = data.get('engine', '').lower()
    if not database_url:
        print(f"Engine field empty or missing. Checking for alternative fields...", file=__import__('sys').stderr)
        # Try to construct from individual fields
        user = data.get('username', '')
        password = data.get('password', '')
        host = data.get('host', '')
        port = data.get('port', '5432')
        if user and password and host:
            database_url = f"postgresql+psycopg://{user}:{password}@{host}:{port}/jakshwealth"
        else:
            print(f"Missing required fields. Got: user={bool(user)}, pass={bool(password)}, host={bool(host)}", file=__import__('sys').stderr)
            database_url = None
    elif database_url.startswith('postgres'):
        user = data.get('username', '')
        password = data.get('password', '')
        host = data.get('host', '')
        port = data.get('port', '5432')
        database_url = f"postgresql+psycopg://{user}:{password}@{host}:{port}/jakshwealth"
    else:
        print(f"Unknown engine in secret: {database_url}", file=__import__('sys').stderr)
        database_url = None

    # Extract Kite API credentials
    kite_api_key = data.get('kite_api_key', '')
    kite_api_secret = data.get('kite_api_secret', '')

    # Write environment file with all credentials
    env_content = ""
    if database_url:
        env_content += f'DATABASE_URL={database_url}\n'
        print(f"DATABASE_URL set from secret {secret_id}")
    if kite_api_key:
        env_content += f'KITE_API_KEY={kite_api_key}\n'
        print(f"KITE_API_KEY set from secret")
    if kite_api_secret:
        env_content += f'KITE_API_SECRET={kite_api_secret}\n'
        print(f"KITE_API_SECRET set from secret")
    fernet_key = data.get('fernet_key', '')
    if fernet_key:
        env_content += f'FERNET_KEY={fernet_key}\n'
        print(f"FERNET_KEY set from secret")
    state_secret = data.get('state_secret', '')
    if state_secret:
        env_content += f'KITE_STATE_SECRET={state_secret}\n'
        print(f"KITE_STATE_SECRET set from secret")

    if env_content:
        Path('/etc/kite-algo-setup/env').write_text(env_content)
    else:
        print(f"No credentials found in secret", file=__import__('sys').stderr)
except Exception as e:
    print(f"Failed to fetch secret: {e}", file=__import__('sys').stderr)
    sys.exit(1)
PY

cat > /etc/systemd/system/kite-desk.service <<'UNIT'
[Unit]
Description=JakshWealth Kite desk
After=network-online.target

[Service]
Type=simple
User=kite-algo-setup
Group=kite-algo-setup
WorkingDirectory=/opt/kite-algo-setup/current
EnvironmentFile=/etc/kite-algo-setup/env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/kite-algo-setup/current
Environment=HOME=/var/lib/kite-algo-setup
Environment=KITE_SESSION_PATH=/var/lib/kite-algo-setup/kite-session.json
Environment=SCANNER_CACHE_PATH=/var/lib/kite-algo-setup/scanner-data.json
Environment=KITE_DB_SECRET_ID=${db_secret_id}
Environment=KITE_SESSION_BUCKET=${artifact_bucket}
Environment=KITE_SESSION_KEY=kite-session/session.json
Environment=SCANNER_CACHE_BUCKET=${artifact_bucket}
Environment=SCANNER_CACHE_KEY=kite-scanner/scanner-data.json
Environment=SCANNER_FILL_BUDGET_SECONDS=45
Environment=ENVIRONMENT=dev
ExecStart=/usr/bin/python3 -m uvicorn kite_app.main:app --host 127.0.0.1 --port 8082
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT



cat > /etc/systemd/system/kite-algo-setup-sync.service <<'UNIT'
[Unit]
Description=Pull the kite-algo-setup API bundle

[Service]
Type=oneshot
ExecStart=/usr/local/bin/kite-algo-setup-sync
UNIT

cat > /etc/systemd/system/kite-algo-setup-sync.timer <<'UNIT'
[Unit]
Description=Look for a new kite-algo-setup API bundle

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
UNIT

# The scan helper was written for port 8080. Nginx owns 8080 and forwards /scans to 8090.
sed -i 's/^PORT = 8080$/PORT = 8090/' /opt/kite-algo-setup/server.py || true

systemctl daemon-reload
systemctl enable --now nginx kite-scan.service kite-algo-setup-sync.timer
/usr/local/bin/kite-algo-setup-sync || true
